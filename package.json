{
  "name": "azwell-backend",
  "version": "0.3.0",
  "description": "Azwell e-commerce backend with Express and SQLite",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "dev": "node --experimental-sqlite --watch server.js",
