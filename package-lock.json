// Simple file-based logger with daily rotation
// No external dependency — uses Node's built-in fs module.
//
// Usage:
//   const logger = require('./logger');
//   logger.info('Order #5 created');
//   logger.error('Payment failed', err);
//   logger.access(req, res, durationMs);
//
// Logs are written to ~/azwell/backend/logs/YYYY-MM-DD.log
// Old logs are auto-cleaned after 30 days.

const fs   = require('fs');
const path = require('path');

const LOG_DIR = process.env.AZWELL_LOG_DIR || path.join(__dirname, 'logs');
const KEEP_DAYS = 30;

// Ensure log directory exists
try {
  if (!fs.existsSync(LOG_DIR)) fs.mkdirSync(LOG_DIR, { recursive: true });
} catch (_) {}

function todayFile() {
  const d = new Date().toISOString().slice(0, 10); // YYYY-MM-DD
  return path.join(LOG_DIR, d + '.log');
}

function timestamp() {
  return new Date().toISOString();
}

function write(level, message, meta) {
  const line = JSON.stringify({
    time:    timestamp(),
    level:   level,
    message: String(message),
    ...(meta ? { meta } : {})
  }) + '\n';

  // Print to console
  if (level === 'error') console.error('[' + level + ']', message, meta || '');
  else if (level === 'warn')  console.warn ('[' + level + ']', message, meta || '');
  else console.log('[' + level + ']', message);

  // Append to file (fire and forget)
  fs.appendFile(todayFile(), line, () => {});
}

function info(msg, meta)  { write('info',  msg, meta); }
function warn(msg, meta)  { write('warn',  msg, meta); }
function error(msg, err)  {
  const meta = err
    ? { error: err.message, stack: err.stack, ...(err.code ? { code: err.code } : {}) }
    : undefined;
  write('error', msg, meta);
}

// Express middleware: log all requests with duration + status
function accessLog(req, res, next) {
  const start = Date.now();
  res.on('finish', () => {
    const ms = Date.now() - start;
    write('access', req.method + ' ' + req.originalUrl, {
      status: res.statusCode,
      ms:     ms,
      ip:     req.ip || req.headers['x-forwarded-for'] || req.socket.remoteAddress,
      ua:     req.headers['user-agent']
    });
  });
  next();
}

// Cleanup old logs (runs once a day)
function cleanupOld() {
  try {
    const files = fs.readdirSync(LOG_DIR);
    const cutoff = Date.now() - KEEP_DAYS * 24 * 60 * 60 * 1000;
    for (const f of files) {
      if (!/\d{4}-\d{2}-\d{2}\.log$/.test(f)) continue;
      const full = path.join(LOG_DIR, f);
      const stat = fs.statSync(full);
      if (stat.mtimeMs < cutoff) fs.unlinkSync(full);
    }
  } catch (e) { /* ignore */ }
}
cleanupOld();
setInterval(cleanupOld, 24 * 60 * 60 * 1000); // every 24h

module.exports = { info, warn, error, accessLog };
